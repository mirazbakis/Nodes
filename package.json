{
  "name": "nodes",
  "productName": "Nodes",
  "version": "1.0.0",
  "description": "Nodes: a team of AI coding agents that runs on every model you have, with automatic fallback. For macOS and Windows.",
  "main": "main.js",
  "author": "Miraz Bakis",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg zip --arm64 --x64",
    "pack": "electron-builder --mac dir",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.athenesoftworks.nodes",
    "productName": "Nodes",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "darkModeSupport": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Nodes lets your phone connect to it over your Wi-Fi."
      },
      "artifactName": "Nodes-${version}-${arch}-mac.${ext}",
      "hardenedRuntime": false
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "phone/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "dmg": {
      "title": "Nodes ${version}",
      "artifactName": "Nodes-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Nodes-${version}-${arch}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nodes",
      "artifactName": "Nodes-${version}-${arch}-setup.${ext}",
      "uninstallDisplayName": "Nodes"
    },
    "portable": {
      "artifactName": "Nodes-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "marked": "^15.0.12"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "repository": "https://github.com/mirazbakis/Nodes",
  "homepage": "https://github.com/mirazbakis/Nodes"
}